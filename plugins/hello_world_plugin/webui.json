{
  "schema_version": 1,
  "workspace_title": "Hello World",
  "pages": [
    {
      "id": "overview",
      "title": "Hello World 概览",
      "description": "演示顶部工作区、统计卡片、数据绑定、图表与表格。数据来自问候体验页的实际操作。",
      "placement": "workspace",
      "icon": "chart",
      "queries": {
        "summary": { "api": "webui_summary", "version": "1" }
      },
      "actions": {
        "reset": {
          "api": "webui_reset_greetings",
          "version": "1",
          "confirmation": "确认清空 Hello World 的问候演示记录？此操作只影响插件内存中的演示数据。"
        }
      },
      "content": [
        {
          "type": "grid",
          "columns": 3,
          "children": [
            { "type": "stat", "label": "本次运行生成次数", "value": { "source": "summary", "field": "greeting_count" } },
            { "type": "stat", "label": "保留记录数", "value": { "source": "summary", "field": "record_count" } },
            { "type": "stat", "label": "查询时的当前时间", "value": { "source": "summary", "field": "current_time" } }
          ]
        },
        {
          "type": "card",
          "label": "最近一次问候",
          "children": [
            { "type": "text", "value": { "source": "summary", "field": "last_greeting" } },
            { "type": "text", "value": "在麦麦侧边栏的“插件扩展 → Hello World 问候体验”中生成问候，再回到本页点击刷新。演示不会发送聊天消息，重载插件后记录会清空。" }
          ]
        },
        {
          "type": "tabs",
          "children": [
            {
              "type": "stack",
              "label": "问候长度",
              "children": [
                { "type": "chart", "label": "最近 20 次问候的字符数", "chart_type": "bar", "x": "label", "y": "characters", "value": { "source": "summary", "field": "chart" } }
              ]
            },
            {
              "type": "stack",
              "label": "最近记录",
              "children": [
                {
                  "type": "table",
                  "value": { "source": "summary", "field": "history" },
                  "columns": [
                    { "field": "sequence", "label": "序号" },
                    { "field": "name", "label": "称呼" },
                    { "field": "message", "label": "问候内容" },
                    { "field": "created_at", "label": "生成时间" }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "button", "label": "清空演示记录", "action": "reset", "variant": "danger" }
      ]
    },
    {
      "id": "greeting",
      "title": "Hello World 问候体验",
      "description": "演示侧边页面、表单参数绑定和操作后的自动刷新；只生成页面预览。",
      "placement": "sidebar",
      "icon": "puzzle",
      "queries": {
        "summary": { "api": "webui_summary", "version": "1" }
      },
      "actions": {
        "generate": {
          "api": "webui_generate_greeting",
          "version": "1",
          "parameters": {
            "name": { "type": "string", "required": true, "max_length": 80 },
            "style": { "type": "string", "required": true, "choices": ["friendly", "formal"] },
            "repeat": { "type": "integer", "required": true, "minimum": 1, "maximum": 5 },
            "include_time": { "type": "boolean", "required": true }
          }
        }
      },
      "content": [
        {
          "type": "card",
          "label": "生成问候",
          "children": [
            {
              "type": "grid",
              "columns": 2,
              "children": [
                { "type": "input", "name": "name", "label": "你的称呼", "value": "世界" },
                {
                  "type": "select", "name": "style", "label": "问候风格", "value": "friendly",
                  "options": [
                    { "label": "亲切（使用插件问候配置）", "value": "friendly" },
                    { "label": "正式", "value": "formal" }
                  ]
                },
                { "type": "input", "name": "repeat", "label": "重复次数（1 到 5）", "value": 1 },
                { "type": "switch", "name": "include_time", "label": "附上当前时间", "value": true }
              ]
            },
            { "type": "button", "label": "生成问候预览", "action": "generate" }
          ]
        },
        {
          "type": "card",
          "label": "预览结果",
          "children": [
            { "type": "text", "value": { "source": "summary", "field": "last_greeting" } }
          ]
        },
        {
          "type": "card",
          "label": "当前插件问候配置",
          "children": [
            { "type": "text", "value": { "source": "summary", "field": "default_greeting" } },
            { "type": "text", "value": "本页演示数据只保存在插件内存中，不会修改 config.toml。要修改默认问候，请使用原有的插件配置页面。" }
          ]
        }
      ]
    }
  ]
}
